# Memory MCP 只连接 Memory Gateway，不直接连接 Hindsight。
MEMORY_GATEWAY_URL=http://127.0.0.1:8787
MEMORY_GATEWAY_TOKEN=replace-me-locally
MEMORY_CLIENT_ID=mcp-client
MEMORY_GATEWAY_TIMEOUT=60

# MCP 仅监听本机；公网由 Cloudflare Tunnel 等 HTTPS 接入层转发。
MEMORY_MCP_HOST=127.0.0.1
MEMORY_MCP_PORT=8000
MEMORY_MCP_PUBLIC_HOST=memory.skyhighmonica.fyi

# 正常生产使用 full；其余模式仅用于故障隔离。
MEMORY_MCP_TOOL_MODE=full

# 详细性能打点默认关闭。定位端到端延迟时临时设为 1，测完恢复 0。
MEMORY_MCP_TIMING_ENABLED=0
MEMORY_MCP_LOG_LEVEL=INFO
