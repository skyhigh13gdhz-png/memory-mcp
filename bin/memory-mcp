#!/usr/bin/env bash
set -euo pipefail
SERVICE="memory-mcp"
INSTALL_DIR="/opt/memory-mcp"
ENV_FILE="/etc/memory-mcp.env"

status() {
  echo "========== Memory MCP 状态 =========="
  local ok=0
  if systemctl is-active --quiet "$SERVICE"; then echo "[✓] MCP 服务：正在运行"; ok=$((ok+1)); else echo "[✗] MCP 服务：未运行"; fi
  if systemctl is-enabled --quiet "$SERVICE" 2>/dev/null; then echo "[✓] 开机自动启动：已启用"; ok=$((ok+1)); else echo "[✗] 开机自动启动：未启用"; fi
  if curl -fsS --max-time 3 http://127.0.0.1:8000/mcp >/dev/null 2>&1 || [[ $(curl -s -o /dev/null -w '%{http_code}' --max-time 3 http://127.0.0.1:8000/mcp || true) != "000" ]]; then echo "[✓] MCP HTTP 端点：可以访问"; ok=$((ok+1)); else echo "[✗] MCP HTTP 端点：无法访问"; fi
  echo; echo "[✓] 正常：${ok}/3 项"
  [[ $ok -eq 3 ]]
}

health() {
  status
  echo
  if curl -fsS --max-time 3 http://127.0.0.1:8787/health >/dev/null; then
    echo "[✓] Memory Gateway：可以访问"
  else
    echo "[✗] Memory Gateway：无法访问"
    exit 1
  fi
}

test_chain() {
  if [[ $EUID -ne 0 ]]; then exec sudo "$0" test; fi
  "$INSTALL_DIR/.venv/bin/python" "$INSTALL_DIR/scripts/smoke-test.py"
}

logs() {
  local mode="current" lines="200"
  [[ ${1:-} == "--history" ]] && { mode="history"; shift; }
  [[ ${1:-} =~ ^[0-9]+$ ]] && lines="$1"
  if [[ $mode == history ]]; then journalctl -u "$SERVICE" -n "$lines" --no-pager; else journalctl -u "$SERVICE" -b -n "$lines" --no-pager; fi
}

timing() {
  if [[ $EUID -ne 0 ]]; then exec sudo "$0" timing "${1:-status}"; fi
  local action="${1:-status}"
  case "$action" in
    on) value=1 ;;
    off) value=0 ;;
    status)
      grep '^MEMORY_MCP_TIMING_ENABLED=' "$ENV_FILE" 2>/dev/null || echo 'MEMORY_MCP_TIMING_ENABLED=0'
      return
      ;;
    *) echo '用法：memory-mcp timing [on|off|status]' >&2; exit 2 ;;
  esac
  if grep -q '^MEMORY_MCP_TIMING_ENABLED=' "$ENV_FILE"; then
    sed -i "s/^MEMORY_MCP_TIMING_ENABLED=.*/MEMORY_MCP_TIMING_ENABLED=$value/" "$ENV_FILE"
  else
    echo "MEMORY_MCP_TIMING_ENABLED=$value" >> "$ENV_FILE"
  fi
  systemctl restart "$SERVICE"
  sleep 1
  systemctl is-active --quiet "$SERVICE" || { journalctl -u "$SERVICE" -n 40 --no-pager; exit 1; }
  echo "[✓] MEMORY_MCP_TIMING_ENABLED=$value；服务已重启"
}

mode() {
  if [[ $EUID -ne 0 ]]; then exec sudo "$0" mode "${1:-status}"; fi
  local action="${1:-status}"
  case "$action" in
    status)
      grep '^MEMORY_MCP_TOOL_MODE=' "$ENV_FILE" 2>/dev/null || echo 'MEMORY_MCP_TOOL_MODE=full'
      return
      ;;
    full|recall-only|recall-schema|ping-only|speaker-probe) ;;
    *) echo '用法：memory-mcp mode [full|speaker-probe|recall-only|recall-schema|ping-only|status]' >&2; exit 2 ;;
  esac
  if grep -q '^MEMORY_MCP_TOOL_MODE=' "$ENV_FILE"; then
    sed -i "s/^MEMORY_MCP_TOOL_MODE=.*/MEMORY_MCP_TOOL_MODE=$action/" "$ENV_FILE"
  else
    echo "MEMORY_MCP_TOOL_MODE=$action" >> "$ENV_FILE"
  fi
  systemctl restart "$SERVICE"
  sleep 1
  systemctl is-active --quiet "$SERVICE" || { journalctl -u "$SERVICE" -n 40 --no-pager; exit 1; }
  echo "[✓] MEMORY_MCP_TOOL_MODE=$action；服务已重启"
}

config() {
  echo "========== Memory MCP 配置 =========="
  echo "配置文件：$ENV_FILE（密钥不显示）"
  if [[ -r $ENV_FILE ]]; then
    grep -E '^(MEMORY_GATEWAY_URL|MEMORY_CLIENT_ID|MEMORY_GATEWAY_TIMEOUT|MEMORY_MCP_HOST|MEMORY_MCP_PORT)=' "$ENV_FILE" || true
  else
    echo "详细配置受 root 权限保护。"
  fi
}

case "${1:-help}" in
  status) status ;;
  health) health ;;
  test) test_chain ;;
  logs) shift; logs "$@" ;;
  restart) [[ $EUID -eq 0 ]] || exec sudo "$0" restart; systemctl restart "$SERVICE"; status ;;
  timing) shift; timing "${1:-status}" ;;
  mode) shift; mode "${1:-status}" ;;
  config) config ;;
  *) cat <<'EOF'
Memory MCP 管理命令：
  memory-mcp status
  memory-mcp health
  memory-mcp test
  memory-mcp logs [行数]
  memory-mcp logs --history [行数]
  memory-mcp restart
  memory-mcp timing [on|off|status]
  memory-mcp mode [full|speaker-probe|recall-only|recall-schema|ping-only|status]
  memory-mcp config
EOF
  ;;
esac
